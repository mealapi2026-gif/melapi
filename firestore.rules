rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && (userProfile().role == 'admin'
        || request.auth.uid == 'Zm6IBgsvXkO9pBRmJlKbJ3YicnA3'
        || request.auth.token.email == 'dionyyr@gmail.com');
    }

    function canRead(menu) {
      return isAdmin()
        || ('menuPermissions' in userProfile()
          && menu in userProfile().menuPermissions
          && userProfile().menuPermissions[menu].read == true)
        || ('accessibleMenus' in userProfile() && menu in userProfile().accessibleMenus);
    }

    function canWrite(menu) {
      return isAdmin()
        || ('menuPermissions' in userProfile()
          && menu in userProfile().menuPermissions
          && userProfile().menuPermissions[menu].write == true);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /petani/{documentId} {
      allow read: if canRead('profil-petani') || canRead('appoli');
      allow write: if canWrite('profil-petani');
    }

    match /analisaUsaha/{documentId} {
      allow read: if canRead('analisa-usaha') || canRead('appoli');
      allow write: if canWrite('analisa-usaha');
    }

    match /inspeksiICS/{documentId} {
      allow read: if canRead('inspeksi-ics') || canRead('appoli');
      allow write: if canWrite('inspeksi-ics');
    }

    match /dataLahan/{documentId} {
      allow read: if canRead('data-lahan') || canRead('appoli');
      allow write: if canWrite('data-lahan');
    }
  }
}